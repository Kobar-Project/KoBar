{
  "name": "kobar",
  "productName": "KoBar",
  "version": "1.4.0",
  "description": "Modular utility sidebar for desktop. Your multi-threaded creative assistant.",
  "author": "Ekrem Edali",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "dev": "concurrently -k --success first \"vite\" \"node tools/build-electron.mjs --watch\" \"wait-on -t 120000 tcp:5173 && wait-on -t 120000 dist-electron/main.cjs && wait-on -t 120000 dist-electron/preload.cjs && wait-on -t 120000 dist-electron/pip-preload.cjs && wait-on -t 120000 dist-electron/settings-preload.cjs && wait-on -t 120000 dist-electron/smtc-worker.cjs && wait-on -t 120000 dist-electron/pdf-worker.cjs && electron .\"",
    "build": "node tools/clean-build.mjs && tsc -b && vite build && tsc -p electron/tsconfig.json && node tools/build-electron.mjs",
    "build:electron": "node tools/build-electron.mjs",
    "kobar-build": "node kobar-build.js",
    "dist:store": "node tools/dist.mjs store --win --publish never",
    "dist:direct:win": "node tools/dist.mjs direct --win --publish never",
    "dist:mac": "node tools/dist.mjs direct --mac --publish never",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=182",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/browser": "^4.2.1",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.18.0",
    "material-symbols": "^0.44.9",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.0.4"
  }
}
