{
    "compilerOptions": {
        "target": "es2022",
        "module": "Node20",
        "moduleResolution": "Node16",
        "lib": [
            "es2022"
        ],
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "**/*.ts",
        "**/*.cts",
        "../shared/**/*.cts",
        "../shared/**/*.ts"
    ]
}