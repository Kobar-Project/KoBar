/** Maps a language tag ("tr", "tr-TR", "zh_CN") to a supported language, or null when unsupported. */
export function parseLanguage(value: unknown): MainLang | null {
    if (typeof value !== 'string') return null;
    const primary = value.trim().toLowerCase().split(/[-_]/)[0];
    return (MAIN_LANGS as readonly string[]).includes(primary) ? (primary as MainLang) : null;
}

/** Like `parseLanguage`, but unsupported values become English. */
export function normalizeLanguage(value: unknown): MainLang {
    return parseLanguage(value) ?? 'en';
}

/** Returns the text for `key` in `lang` (English when missing), with {placeholders} replaced from `params`. */
export function t(lang: unknown, key: MainStringKey, params?: Record<string, string>): string {
    const table = MAIN_STRINGS[normalizeLanguage(lang)];
    const text = table?.[key] || MAIN_STRINGS.en[key] || '';
    if (!params) return text;
    // A function replacer keeps "$&" and similar sequences in dynamic values literal.
    return text.replace(/\{(\w+)\}/g, (whole, name: string) => (Object.prototype.hasOwnProperty.call(params, name) ? params[name] : whole));
}
